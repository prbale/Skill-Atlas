# ---- Skill Atlas production settings (copy to .env and edit) ----
SITE_DOMAIN=atlas.example.com
PUBLIC_ORIGIN=https://atlas.example.com

# First administrator (only used when no administrator exists yet).
# Pick something less guessable than "admin". The password goes in secrets/admin_password.txt, not here.
ADMIN_USERNAME=prashant-admin

# Who can create accounts: invite (needs an invite code from an admin), closed (admins only), open (anyone)
REGISTRATION=invite
MAX_USERS=50

# 1 when Caddy is the only proxy in front of the app. If you also put Cloudflare in front, see README → "Behind Cloudflare".
TRUSTED_PROXY_HOPS=1

# Refuse passwords found in known breaches (privacy-preserving HIBP range check)
HIBP_CHECK=true

# Optional off-site backups (docker compose --profile backup up -d)
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
